# Postgres connection used by the daemon
DATABASE_URL=postgresql://sismos:sismos@localhost:5432/sismos

# Used by the intensity engine (intensity.py) to compute hypocentral
# distance and locally-felt intensity. REQUIRED, no default (config.py
# raises at startup if missing) -- a missing/blank value used to silently
# fall back to a placeholder location and mis-score every event's
# distance/intensity against the wrong place. The values below are not
# valid floats on purpose, so copying this file to .env without editing
# fails loudly instead of booting against a plausible-looking wrong spot.
HOME_LAT=REPLACE_WITH_REAL_LATITUDE
HOME_LON=REPLACE_WITH_REAL_LONGITUDE

# Everything below has a sensible default (see config.py) and only
# needs to be set to override it.
# EMSC_WS_URL=wss://www.seismicportal.eu/standing_order/websocket
# USGS_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
# USGS_POLL_INTERVAL_S=60
# USGS_WINDOW_MINUTES=30
# USGS_MIN_MAGNITUDE_GLOBAL=4.0
# USGS_MIN_MAGNITUDE_CHILE=2.5
# CSN_URL=https://api.gael.cloud/general/public/sismos
# CSN_POLL_INTERVAL_S=300

# Self-hosted ntfy server for post-event notifications (see alerts.py).
# Base URL only -- no topic path, alerts.send() posts the topic in the
# request body. docker-compose.yml points this at the `ntfy` service; for
# host dev, run `docker run -p 80:80 binwiederhier/ntfy serve` or similar.
# NTFY_URL=http://localhost:80
# NTFY_TOPIC=sismos
