# Postgres connection used by the API (read-only: the daemon is the only
# writer)
DATABASE_URL=postgresql://sismos:sismos@localhost:5432/sismos

# Comma-separated list of allowed CORS origins, or "*" for any (default).
# Tighten this once infra/Caddy (fase 4) puts the API behind a real origin.
# CORS_ORIGINS=*

# LOG_LEVEL=INFO
