# Postgres connection used by the API (read-only: the daemon is the only
# writer)
DATABASE_URL=postgresql://sismos:sismos@localhost:5432/sismos

# Comma-separated list of allowed CORS origins, or "*" for any (default).
# Tighten this once infra/Caddy (fase 4) puts the API behind a real origin.
# CORS_ORIGINS=*

# LOG_LEVEL=INFO

# Expuestos de solo lectura en GET /api/config para web/ (mapa, rumbo,
# barra superior). Deben coincidir con HOME_LAT/HOME_LON en daemon/.env --
# la API no recalcula nada, solo refleja la misma ubicación que usa el
# GMPE del daemon. REQUERIDO, sin default (config.py falla al iniciar si
# faltan) -- valores no numéricos a propósito, para que copiar este
# archivo sin editar falle ruidosamente en vez de arrancar apuntando a un
# lugar equivocado en silencio.
HOME_LAT=REEMPLAZAR_CON_LATITUD_REAL
HOME_LON=REEMPLAZAR_CON_LONGITUD_REAL
# HOME_LABEL=Casa
# POLL_INTERVAL_S=30
